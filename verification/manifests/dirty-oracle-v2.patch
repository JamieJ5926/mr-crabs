+// Built-in cursor glow and motion trail effect.
+//
+// This shader is not meant to be loaded by users; it is prepended before
+// any user `custom-shader` files when the `cursor-trail` configuration is
+// enabled. It runs as the first post-processing pass.
+//
+// It draws a soft glow around the current cursor rectangle and a trail
+// connecting the previous and current cursor rectangles, fading out
+// linearly over the configured duration after each cursor movement.
+// Outside the cursor/transition region, when the cursor is hidden, or
+// when the surface is unfocused, iChannel0 is passed through unchanged.
+
+// The opacity of the effect. Specialized at shader generation time from
+// the `cursor-trail-opacity` configuration.
+#ifndef CURSOR_TRAIL_OPACITY
+#define CURSOR_TRAIL_OPACITY 0.35
+#endif
+
+// The fade duration in seconds. Specialized at shader generation time from
+// the `cursor-trail-duration` configuration.
+#ifndef CURSOR_TRAIL_DURATION
+#define CURSOR_TRAIL_DURATION 0.25
+#endif
+
+// Signed distance (in pixels) from a point to the rectangle
+// [rect.xy, rect.xy + rect.zw]. Zero inside the rectangle, positive
+// outside.
+float cursorTrailRectDistance(vec2 point, vec4 rect) {
+    vec2 d = abs(point - (rect.xy + 0.5 * rect.zw)) - 0.5 * rect.zw;
+    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
+}
+
+// Distance (in pixels) from a point to the segment [a, b]. Degenerate
+// segments (a == b) reduce to the distance to the point.
+float cursorTrailSegmentDistance(vec2 point, vec2 a, vec2 b) {
+    vec2 ab = b - a;
+    float len2 = dot(ab, ab);
+    float t = len2 > 0.0 ? clamp(dot(point - a, ab) / len2, 0.0, 1.0) : 0.0;
+    return length(point - (a + t * ab));
+}
+
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+    // Start with the terminal frame unchanged. All branches below only
+    // blend additional color over the cursor/transition region.
+    vec4 frame = texture2D(iChannel0, fragCoord / iResolution.xy);
+    fragColor = frame;
+
+    // The cursor is hidden when the surface is unfocused, so there is
+    // nothing to draw in either case.
+    if (iCursorVisible == 0 || iFocus == 0) return;
+
+    // A degenerate rectangle means we have no cursor position yet.
+    vec4 current = iCurrentCursor;
+    if (current.z <= 0.0 || current.w <= 0.0) return;
+
+    // Fade out linearly over the configured duration. Once the duration
+    // has elapsed the effect is fully transparent and we can stop.
+    float elapsed = max(iTime - iTimeCursorChange, 0.0);
+    if (elapsed >= CURSOR_TRAIL_DURATION) return;
+    float fade = 1.0 - (elapsed / CURSOR_TRAIL_DURATION);
+
+    // The glow radius scales with the cursor size so that the effect looks
+    // the same at any cell size or display scale factor.
+    float radius = 0.5 * max(current.z, current.w);
+
+    // Soft glow around the current cursor rectangle.
+    float d_current = cursorTrailRectDistance(fragCoord, current);
+    float glow = exp(-d_current / radius);
+
+    // Trail between the previous and current cursor rectangles. The trail
+    // is a glow along the segment connecting the two rectangle centers; if
+    // the cursor is stationary the segment is degenerate and the current
+    // cursor glow above fully covers it.
+    float trail = 0.0;
+    vec4 previous = iPreviousCursor;
+    if (previous.z > 0.0 && previous.w > 0.0) {
+        vec2 prev_center = previous.xy + 0.5 * previous.zw;
+        vec2 curr_center = current.xy + 0.5 * current.zw;
+        float d_trail = cursorTrailSegmentDistance(fragCoord, prev_center, curr_center);
+        trail = exp(-d_trail / radius);
+    }
+
+    // Blend the cursor color over the frame with the effect's alpha. The
+    // alpha is zero outside the glow/trail region, so those pixels are
+    // passed through unchanged.
+    float alpha = max(glow, trail) * fade * CURSOR_TRAIL_OPACITY;
+    fragColor = vec4(mix(frame.rgb, iCurrentCursorColor.rgb, alpha), frame.a);
+}
diff --git a/src/renderer/shaders/streaming-text.glsl b/src/renderer/shaders/streaming-text.glsl
new file mode 100644
index 000000000..025be5ba3
--- /dev/null
+++ b/src/renderer/shaders/streaming-text.glsl
@@ -0,0 +1,81 @@
+// Built-in streaming text reveal effect.
+//
+// This shader is not meant to be loaded by users; it is prepended before
+// the built-in cursor trail effect and any user `custom-shader` files when
+// the `text-animation` configuration is `streaming`. It runs as the first
+// post-processing pass.
+//
+// It reveals newly changed glyph output left-to-right over the configured
+// duration. A per-cell change-time texture (iChannel1, one texel per grid
+// cell) records when each cell's rendered content last changed; cells that
+// never changed are sentinel and pass through unchanged, so only newly
+// changed glyph output animates and the rest of the screen stays stable.
+//
+// The effect is purely visual: the terminal state, accessibility, and
+// selection always expose the final text immediately.
+
+// The reveal duration in seconds. Specialized at shader generation time
+// from the `text-animation-duration` configuration.
+#ifndef TEXT_ANIM_DURATION
+#define TEXT_ANIM_DURATION 0.12
+#endif
+
+// The effect intensity in [0, 1]. Specialized at shader generation time
+// from the `text-animation-intensity` configuration. A value of 1 fully
+// hides newly changed glyphs until the reveal passes them; lower values
+// show them partially, and 0 disables the visual effect entirely.
+#ifndef TEXT_ANIM_INTENSITY
+#define TEXT_ANIM_INTENSITY 1.0
+#endif
+
+// The change-time texture: one texel per grid cell (rgba8), row 0 is the
+// top row of the grid. Each texel holds the IEEE-754 bit pattern of the
+// shader time at which the cell's content last changed, split into bytes.
+// iChannelResolution[1].xy is the grid size in cells and iCellMetrics is
+// (cell width, signed row step, row-zero origin x, row-zero origin y) in
+// pixels; the row step is negative for bottom-up shader coordinates.
+layout(binding = 1) uniform sampler2D iChannel1;
+
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+    // Start with the terminal frame unchanged. All branches below only
+    // hide (blend toward the terminal background) the unrevealed portion
+    // of cells whose reveal is still in progress.
+    vec4 frame = texture2D(iChannel0, fragCoord / iResolution.xy);
+    fragColor = frame;
+
+    // Grid size in cells. Zero means the grid hasn't been set up yet.
+    vec2 grid = iChannelResolution[1].xy;
+    if (grid.x <= 0.0 || grid.y <= 0.0) return;
+
+    // The cell this fragment belongs to. iCellMetrics.zw is the top-left
+    // of the grid in this shader's coordinate space, so cell.y counts rows
+    // from the top and maps directly to the change texture rows.
+    vec2 cell = floor((fragCoord.xy - iCellMetrics.zw) / iCellMetrics.xy);
+    if (cell.x < 0.0 || cell.y < 0.0 || cell.x >= grid.x || cell.y >= grid.y) return;
+
+    // Reconstruct the change time for this cell. Cells that never changed
+    // hold a large negative sentinel so the elapsed time below is far past
+    // the duration and the cell passes through unchanged.
+    vec4 raw = texture2D(iChannel1, (cell + 0.5) / grid);
+    uvec4 bytes = uvec4(floor(raw * 255.0 + 0.5));
+    uint bits = bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (bytes.a << 24u);
+    float change_time = uintBitsToFloat(bits);
+
+    // Only cells whose change is still within the reveal window animate.
+    float elapsed = iTime - change_time;
+    if (elapsed < 0.0 || elapsed >= TEXT_ANIM_DURATION) return;
+
+    // Reveal left-to-right: the reveal boundary sweeps across the cell
+    // over the duration, starting at the cell's left edge at the change
+    // time. Pixels left of the boundary are fully revealed; pixels to the
+    // right are hidden with a soft edge, scaled by the intensity.
+    float reveal = elapsed / TEXT_ANIM_DURATION;
+    float cell_left = cell.x * iCellMetrics.x + iCellMetrics.z;
+    float local_x = fragCoord.x - cell_left;
+    float boundary = reveal * iCellMetrics.x;
+    float dist = local_x - boundary;
+    if (dist <= 0.0) return;
+
+    float hidden = TEXT_ANIM_INTENSITY * (1.0 - reveal) * smoothstep(0.0, 2.0, dist);
+    fragColor = vec4(mix(frame.rgb, iBackgroundColor, hidden), frame.a);
+}
diff --git a/src/renderer/shaders/typewriter-text.glsl b/src/renderer/shaders/typewriter-text.glsl
new file mode 100644
index 000000000..c56f39433
--- /dev/null
+++ b/src/renderer/shaders/typewriter-text.glsl
@@ -0,0 +1,103 @@
+// Built-in typewriter text reveal effect.
+//
+// This shader is not meant to be loaded by users; it is prepended before
+// the built-in cursor trail effect and any user `custom-shader` files when
+// the `text-animation` configuration is `typewriter`. It runs as the first
+// post-processing pass.
+//
+// It reveals newly changed glyph output one character at a time: the
+// renderer timestamps each changed cell in terminal reading order with a
+// short fixed stagger derived from the configured duration (one eighth of
+// the duration per character), and this shader pops each cell in over a
+// quick window starting at its own timestamp. A per-cell change-time
+// texture (iChannel1, one texel per grid cell) records when each cell's
+// rendered content last changed; cells that never changed are sentinel
+// and pass through unchanged, so only newly changed glyph output animates
+// and the rest of the screen (including old text) stays stable.
+//
+// The effect is purely visual: the terminal state, accessibility, and
+// selection always expose the final text immediately.
+
+// The reveal duration in seconds. Specialized at shader generation time
+// from the `text-animation-duration` configuration.
+#ifndef TEXT_ANIM_DURATION
+#define TEXT_ANIM_DURATION 0.12
+#endif
+
+// The effect intensity in [0, 1]. Specialized at shader generation time
+// from the `text-animation-intensity` configuration. A value of 1 fully
+// hides newly changed glyphs until the reveal passes them; lower values
+// show them partially, and 0 disables the visual effect entirely.
+#ifndef TEXT_ANIM_INTENSITY
+#define TEXT_ANIM_INTENSITY 1.0
+#endif
+
+// The change-time texture: one texel per grid cell (rgba8), row 0 is the
+// top row of the grid. Each texel holds the IEEE-754 bit pattern of the
+// shader time at which the cell's content last changed, split into bytes.
+// iChannelResolution[1].xy is the grid size in cells and iCellMetrics is
+// (cell width, signed row step, row-zero origin x, row-zero origin y) in
+// pixels; the row step is negative for bottom-up shader coordinates.
+layout(binding = 1) uniform sampler2D iChannel1;
+
+void mainImage(out vec4 fragColor, in vec2 fragCoord) {
+    // Start with the terminal frame unchanged. All branches below only
+    // hide (blend toward the terminal background) the unrevealed portion
+    // of cells whose reveal is still in progress.
+    vec4 frame = texture2D(iChannel0, fragCoord / iResolution.xy);
+    fragColor = frame;
+
+    // Grid size in cells. Zero means the grid hasn't been set up yet.
+    vec2 grid = iChannelResolution[1].xy;
+    if (grid.x <= 0.0 || grid.y <= 0.0) return;
+
+    // The cell this fragment belongs to. iCellMetrics.zw is row zero's
+    // origin and the signed row step makes cell.y increase top-to-bottom
+    // on both top-down and bottom-up graphics APIs.
+    vec2 cell = floor((fragCoord.xy - iCellMetrics.zw) / iCellMetrics.xy);
+    if (cell.x < 0.0 || cell.y < 0.0 || cell.x >= grid.x || cell.y >= grid.y) return;
+
+    // Recover the already-composited background from a glyph-free corner
+    // of this cell. This preserves terminal opacity and per-cell colors
+    // instead of replacing hidden glyphs with the raw global config color.
+    vec2 cell_origin = iCellMetrics.zw + cell * iCellMetrics.xy;
+    vec3 cell_background = texture2D(
+        iChannel0,
+        (cell_origin + vec2(0.5)) / iResolution.xy
+    ).rgb;
+
+    // Reconstruct the change time for this cell. Cells that never changed
+    // hold a large negative sentinel so the elapsed time below is far past
+    // the reveal window and the cell passes through unchanged.
+    vec4 raw = texture2D(iChannel1, (cell + 0.5) / grid);
+    uvec4 bytes = uvec4(floor(raw * 255.0 + 0.5));
+    uint bits = bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (bytes.a << 24u);
+    float change_time = uintBitsToFloat(bits);
+
+    // Only cells whose change is still within the reveal window animate.
+    // The window is the configured duration, but the character itself
+    // strikes in over the first quarter of it so consecutive staggered
+    // characters pop in one after another rather than smearing across
+    // the whole duration.
+    float elapsed = iTime - change_time;
+    if (elapsed >= TEXT_ANIM_DURATION) return;
+    if (elapsed < 0.0) {
+        fragColor = vec4(mix(frame.rgb, cell_background, TEXT_ANIM_INTENSITY), frame.a);
+        return;
+    }
+
+    // The strike: the character appears over the first quarter of its
+    // window with a left-to-right sweep across the cell, like a
+    // typewriter's ink hitting the page. Once the strike completes the
+    // character stays fully visible for the rest of its window.
+    float strike = TEXT_ANIM_DURATION * 0.25;
+    float t = clamp(elapsed / strike, 0.0, 1.0);
+    float cell_left = cell.x * iCellMetrics.x + iCellMetrics.z;
+    float local_x = fragCoord.x - cell_left;
+    float boundary = t * iCellMetrics.x;
+    float dist = local_x - boundary;
+    if (dist <= 0.0) return;
+
+    float hidden = TEXT_ANIM_INTENSITY * (1.0 - t) * smoothstep(0.0, 2.0, dist);
+    fragColor = vec4(mix(frame.rgb, cell_background, hidden), frame.a);
+}
