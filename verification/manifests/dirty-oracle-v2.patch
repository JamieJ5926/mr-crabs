+/// A hash of the rendered-relevant content of a terminal cell. This is
+/// used to detect which cells changed between rebuilds so the built-in
+/// text animation only animates newly changed glyph output.
+///
+/// The key covers the glyph (including grapheme clusters), the wide/
+/// spacer properties, and the denormalized style (colors and flags).
+/// Cursor, selection, and search-highlight state are not part of the key
+/// because they are not terminal content; changes to them never animate.
+fn cellRenderKey(cell: terminal.RenderState.Cell) u64 {
+    var hasher = std.hash.Wyhash.init(0);
+
+    // The raw page cell is a packed u64 covering the content tag, content,
+    // style id, wide/spacer property, protection, hyperlink, and semantic
+    // content, so its bytes are a complete and padding-free key component.
+    hasher.update(std.mem.asBytes(&cell.raw));
+
+    // The style is undefined unless the cell has styling.
+    const style: terminal.Style = if (cell.raw.hasStyling()) cell.style else .{};
+    hasher.update(std.mem.asBytes(&style.flags));
+    hashColor(&hasher, style.fg_color);
+    hashColor(&hasher, style.bg_color);
+    hashColor(&hasher, style.underline_color);
+
+    // The grapheme data is undefined unless the cell is a grapheme head.
+    if (cell.raw.hasGrapheme()) {
+        for (cell.grapheme) |cp| hasher.update(std.mem.asBytes(&cp));
+    }
+
