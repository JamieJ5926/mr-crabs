+    switch (color) {
+        .none => hasher.update(&[1]u8{0}),
+        .palette => |idx| hasher.update(&[2]u8{ 1, idx }),
+        .rgb => |rgb| hasher.update(&[4]u8{ 2, rgb.r, rgb.g, rgb.b }),
