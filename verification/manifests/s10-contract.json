  "acceptance": [
    "Every S10 callable-parity ID maps exactly once to production symbols and tests (see parity_map)",
    "cargo build -p mr-crabs-app --bin mr-crabs compiles after parent formatting",
    "Headless behavioral tests cover tab/split resize, close cascade, and restore round trips",
    "Keyboard-only operation verified through the default keymap end-to-end",
    "PTY ownership bounded (mr-crabs-pty queues) and shut down deterministically (close paths + Drop)",
    "Update/crash reporting interfaces ship explicit disabled/local implementations; no network telemetry",
    "No GUI launch; parent owns all builds, tests, lint, and integration",
    "Current AppCore API preserved source compatible (additive methods only)"
  ],
  "constraints": [
    "Do not run formatting, builds, tests, lint, benchmarks, or the oracle",
    "Do not launch any GUI",
    "Do not edit callable-parity.json; lead updates acceptance state",
    "Do not commit",
    "No direct dependency on S6-S9 crates",
    "Preserve inherited Ghostty product behaviors as modeled production state; nothing deleted"
  ]
}
