    { "id": "shell-state-restore", "status": "implemented", "symbols": ["ShellStateV1", "RestoreStore::snapshot/save/load/apply", "SplitTreeStateV1", "AppModel::apply_restore_state"], "tests": ["round_trip_preserves_windows_tabs_tree_and_focus", "save_and_load_round_trip_through_disk", "unsupported_versions_are_rejected", "invalid_trees_are_rejected", "restore_round_trip_preserves_structure_and_focus"] }
