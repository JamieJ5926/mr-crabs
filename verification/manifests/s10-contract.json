{
  "schema_version": 1,
  "slice": "S10",
  "title": "GPUI product shell",
  "base_commit": "a56687bfad4e243d6930b9f6803b081bfb08d266",
  "scope": [
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/crates/mr-crabs-app/**",
    "rust/verification/manifests/s10-*.json",
    "rust/verification/shell-corpus/**"
  ],
  "required_api": {
    "shell-model": [
      "AppModel (windows/tabs/panes, focus, dispatch, pump, shutdown_all) with headless construction",
      "WindowModel (tab_order, active_tab, close_tab cascade, resize, cycle_tab)",
      "TabModel (split tree, close_pane cascade, goto_split, cycle_pane, resize_all, close_all)",
      "SplitTree recursive splits (split/remove collapse/resize/rects/neighbor/next) with PaneId",
      "PaneModel + PaneSession (bounded mr-crabs-pty lifecycle, deterministic shutdown, Arc<FrameDelta> handoff)"
    ],
    "command-palette": [
      "CommandRegistry (register/unregister/search/dispatch) with one shell.<action> command per AppAction",
      "PaletteState (open/query/navigate/activate) headless"
    ],
    "settings": [
      "AppSettings typed JSON with Ghostty-compatible defaults",
      "SettingsStore atomic reload (parse fully, then swap; generation bump; errors never half-apply)"
    ],
    "quick-terminal": [
      "QuickTerminalState + AppModel show/hide/toggle; hidden windows keep live sessions"
    ],
    "menus": [
      "MenuModel/MenuDef/MenuItemDef default_shell structure; GPUI conversion in ui::menus"
    ],
    "secure-input": [
      "SecureInputState (toggle/track/clear) + SecureInputBackend trait + explicit DisabledSecureInputBackend"
    ],
    "accessibility": [
      "AccessibilitySnapshot/Node from model (window/tab/pane/grid/palette) + perform(action) routing"
    ],
    "app-intents": [
      "AppIntent::parse_url (ghostty://open, ghostty://open-url) + bounded IntentRouter records"
    ],
    "dock-behavior": [
      "DockBehavior (items, recent_documents bounded, activation_policy, reopen_action) + AppModel::handle_reopen"
    ],
    "updates": [
      "UpdateService trait + DisabledUpdateService + LocalManifestUpdateService; no network I/O"
    ],
    "crash-reporting": [
      "CrashReporter trait + DisabledCrashReporter + LocalFileCrashReporter (JSON, bounded rotation)"
    ],
    "platform-integrations": [
      "PlatformCapabilities (kind, menu_bar, dock, accessibility, pty_spawn, ...) with macos()/headless()/current()"
    ],
    "restore": [
      "ShellStateV1 versioned persistence (snapshot/save/load/apply) with tree/pane/focus validation"
    ],
    "keyboard-only-operation": [
      "KeyBindingDef + KeymapResolver + default_keybindings; every shell action keyboard-dispatachable"
    ],
    "binary": [
      "bin target mr-crabs: gpui_platform::application, one window, focus, keybindings, menus, accessibility roles, TerminalElement rendering"
    ]
  },
  "parity_map": [
